# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Dev database from compose.yaml (service "db", host port 5433).
DATABASE_URL=postgresql://tempo:tempo@localhost:5433/tempo
# Integration tests DROP and recreate this database's schema; its name must end in _test.
# Service "db-test" from compose.yaml, host port 5434.
TEST_DATABASE_URL=postgresql://tempo:tempo@localhost:5434/tempo_test
# Password for every user created by `npm run db:seed` (dev only, min 12 chars).
SEED_PASSWORD=TempoDev!2026

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Max JSON body size, e.g. 100kb, 1mb.
BODY_LIMIT=100kb
# Number of reverse proxies in front of the api (0 = none). Affects req.ip and rate limits.
TRUST_PROXY=0

# Signing key for access tokens. Generate: openssl rand -base64 48
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-chars
# Encryption key for TOTP secrets (base64 of 32 bytes). Generate: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktY2hhbmdlLW1lLTMyYiE=
REFRESH_TOKEN_TTL_DAYS=14
# Used in invite and password-reset links.
WEB_APP_URL=http://localhost:5173
MAIL_FROM=TEMPO <no-reply@tempo.test>
# Dev mail transport: invite/reset emails are written here as JSON files.
MAIL_OUTBOX_DIR=.outbox
